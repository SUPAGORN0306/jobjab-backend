# ============================================
# JobJab Backend — Environment Variables
# ============================================
# วิธีใช้:
#   1. cp .env.example .env
#   2. ./scripts/generate_secrets.sh  (เพื่อสร้าง keys)
#   3. เติมค่าจริงใน .env
#
# ⚠️  ห้าม commit .env เด็ดขาด!
# ============================================

# ---------- Core ----------
ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1

# ---------- Database (Supabase) ----------
DATABASE_URL=

# ---------- Supabase Storage ----------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- JWT ----------
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# ---------- CSRF ----------
CSRF_TOKEN_EXPIRES_HOURS=24

# ---------- Redis (Upstash) ----------
# dev:     memory://
# prod:    rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=memory://

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,https://jobjab-one.vercel.app

# ---------- Cookies ----------
# prod:  COOKIE_DOMAIN=.jobjab-api.onrender.com
# prod:  COOKIE_SECURE=1
COOKIE_DOMAIN=
COOKIE_SECURE=0

# ---------- Rate Limit ----------
RATELIMIT_STORAGE_URI=
RATELIMIT_ENABLED=1

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---------- Sentry (optional) ----------
SENTRY_DSN=