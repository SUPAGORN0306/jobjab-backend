      "start_date": "2017-01-01",
      "end_date": "2021-01-01",
      "is_current": false,
      "gpa": 3.50
    }
  ]
}

### 4. ดูรายละเอียดใบสมัคร (Snapshot)
GET http://localhost:5000/api/applications/12/detail

### 5. ดูใบสมัครทั้งหมดของผู้ใช้
GET http://localhost:5000/api/applications/user/1

### 6. ดูงานทั้งหมด
GET http://localhost:5000/api/jobs

### 7. ดูรายละเอียดงาน
GET http://localhost:5000/api/jobs/5